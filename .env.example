# --- Busca ---
SEARXNG_URL=http://localhost:8888
ABSTRATOR_USER_AGENT=abstrator/0.1 (+https://github.com/MateusLOS/abstrator)
ABSTRATOR_SEARCH_BACKEND=searxng
ABSTRATOR_REQUEST_TIMEOUT=20
ABSTRATOR_RATE_LIMIT_PER_DOMAIN=1.0
ABSTRATOR_FETCH_CONCURRENCY=4
ABSTRATOR_MAX_PAGES_PER_NODE=6
ABSTRATOR_RESPECT_ROBOTS=true

# --- LLM Provider ---
# Execute 'abstrator setup' para configurar interativamente
# Providers: claude_code_cli | anthropic | openrouter | gemini_cli | opencode_zen | ollama
ABSTRATOR_LLM_PROVIDER=claude_code_cli
ABSTRATOR_LLM_MODEL=claude-haiku-4-5-20251001
ABSTRATOR_LLM_TIMEOUT=120
ABSTRATOR_LLM_MAX_RETRIES=2

# --- Claude Code CLI (oauth/pro — sem chave de API) ---
# Requer Claude Code instalado: https://claude.ai/code
# Trocar para: abstrator config provider claude_code_cli

# --- Anthropic API ---
# ABSTRATOR_LLM_PROVIDER=anthropic
# ABSTRATOR_LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-...

# --- OpenRouter (50 req/dia gratuito) ---
# ABSTRATOR_LLM_PROVIDER=openrouter
# ABSTRATOR_LLM_MODEL=google/gemma-3-27b-it:free
# OPENROUTER_API_KEY=sk-or-...

# --- Gemini CLI (gratuito, sem chave) ---
# ABSTRATOR_LLM_PROVIDER=gemini_cli
# ABSTRATOR_GEMINI_CLI_MODEL=gemini-2.5-pro
# ABSTRATOR_GEMINI_CLI_TIMEOUT=300

# --- OpenCode ---
# ABSTRATOR_LLM_PROVIDER=opencode_zen
# ABSTRATOR_LLM_MODEL=claude-sonnet-5
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/inference/v1

# --- Ollama (local, sem custo) ---
# ABSTRATOR_LLM_PROVIDER=ollama
# ABSTRATOR_LLM_MODEL=qwen2.5:14b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Budget padrão (standard) ---
ABSTRATOR_BUDGET_MAX_QUERIES=60
ABSTRATOR_BUDGET_MAX_PAGES=120
ABSTRATOR_BUDGET_MAX_LLM_CALLS=80
ABSTRATOR_BUDGET_MAX_TOKENS=400000
ABSTRATOR_BUDGET_MAX_SECONDS=900
ABSTRATOR_BUDGET_MAX_USD=2.0

# --- Storage ---
ABSTRATOR_DATA_DIR=data
ABSTRATOR_RUNS_DIR=runs
ABSTRATOR_CACHE_TTL_HOURS=72
ABSTRATOR_CONCEPT_CACHE_TTL_HOURS=336
