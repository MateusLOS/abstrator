# --- Busca ---
SEARXNG_URL=http://localhost:8080
ABSTRATOR_USER_AGENT=abstrator/0.1 (+https://github.com/local/abstrator)
ABSTRATOR_SEARCH_BACKEND=searxng
ABSTRATOR_REQUEST_TIMEOUT=20
ABSTRATOR_RATE_LIMIT_PER_DOMAIN=1.0
ABSTRATOR_FETCH_CONCURRENCY=4
ABSTRATOR_MAX_PAGES_PER_NODE=6
ABSTRATOR_RESPECT_ROBOTS=true

# --- LLM ---
# auto | opencode_zen | gemini_cli | fake
ABSTRATOR_LLM_PROVIDER=opencode_zen
ABSTRATOR_LLM_MODEL=claude-sonnet-5
ABSTRATOR_LLM_TIMEOUT=120
ABSTRATOR_LLM_MAX_RETRIES=2
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/v1
ABSTRATOR_GEMINI_CLI_MODEL=gemini-2.5-pro
ABSTRATOR_GEMINI_CLI_TIMEOUT=300
# alternativa sem chave (default caido em modelos free do gateway):
# ABSTRATOR_LLM_PROVIDER=gemini_cli
# ABSTRATOR_LLM_MODEL=space-bunny-free

# --- Budget padrao (standard) ---
ABSTRATOR_BUDGET_MAX_QUERIES=60
ABSTRATOR_BUDGET_MAX_PAGES=120
ABSTRATOR_BUDGET_MAX_LLM_CALLS=80
ABSTRATOR_BUDGET_MAX_TOKENS=400000
ABSTRATOR_BUDGET_MAX_SECONDS=900
ABSTRATOR_BUDGET_MAX_USD=2.0

# --- Storage ---
ABSTRATOR_DATA_DIR=data
ABSTRATOR_RUNS_DIR=runs
ABSTRATOR_CACHE_TTL_HOURS=72
ABSTRATOR_CONCEPT_CACHE_TTL_HOURS=336